# ── Polplab · configuración de servidor (Apache / LiteSpeed) ──────────────

RewriteEngine On

# 1 · Forzar https://polplab.com  (sin www, siempre HTTPS) en un solo salto
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://polplab.com%{REQUEST_URI} [L,R=301]

# 1b · index.html no es una URL aparte: /index.html -> /  y  /blog/index.html -> /blog/
# Sin esto cada pagina existe en dos URLs distintas (ambas devolvian 200).
# THE_REQUEST mira la peticion original, asi que las reescrituras internas
# hacia index.html no vuelven a entrar aqui y no se crea un bucle.
RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
RewriteRule ^(.*/)?index\.html$ /%1 [R=301,L]

# 2 · Página de error propia
ErrorDocument 404 /404.html

# 3 · No listar el contenido de las carpetas
Options -Indexes

# 4 · Compresión de texto
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml \
    application/javascript application/json application/xml \
    image/svg+xml application/rss+xml
</IfModule>
<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/xml \
    application/javascript application/json application/xml image/svg+xml
</IfModule>

# 5 · Caché de estáticos
<IfModule mod_expires.c>
  ExpiresActive On

  # Imágenes y favicon: 1 año (cambian poco y tienen nombres propios)
  ExpiresByType image/jpeg              "access plus 1 year"
  ExpiresByType image/png               "access plus 1 year"
  ExpiresByType image/webp              "access plus 1 year"
  ExpiresByType image/svg+xml           "access plus 1 year"
  ExpiresByType image/x-icon            "access plus 1 year"

  # CSS y JS: 1 año (se versionan con ?v= en el HTML; un cambio de contenido
  # se sirve con una URL distinta, así que cachear de más no oculta cambios)
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"

  # HTML y datos: revalidar siempre para que los cambios se vean al instante
  ExpiresByType text/html              "access plus 0 seconds"
  ExpiresByType application/xml        "access plus 0 seconds"
  ExpiresByType text/xml               "access plus 0 seconds"
</IfModule>

# 6 · Cabecera de caché coherente para imágenes (por si mod_expires no está)
<IfModule mod_headers.c>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# 7 · Favicon: caché corta y revalidable
# Su URL no cambia nunca, así que "immutable" + 1 año le decía a Google y a los
# navegadores que jamás volvieran a pedirlo: al actualizar el icono seguían
# sirviendo el antiguo. Con 1 día y must-revalidate el cambio se propaga.
<IfModule mod_headers.c>
  <FilesMatch "^favicon\.(png|ico)$">
    Header set Cache-Control "public, max-age=86400, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  <FilesMatch "^favicon\.(png|ico)$">
    ExpiresActive On
    ExpiresDefault "access plus 1 day"
  </FilesMatch>
</IfModule>
